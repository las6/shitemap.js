# Server-side Kurkelo service origin. Development defaults to localhost:8787.
KURKELO_URL=http://localhost:8787
# Required when the hosted Kurkelo service uses bearer authentication.
KURKELO_API_KEY=

# Production API quotas require the Vercel Firewall rule "shitemap-api".
# VERCEL, VERCEL_URL and the trusted client IP are supplied by Vercel.
# Configure/verify the rule before deployment; missing quotas return HTTP 503.
# See docs/HARDENING.md. Development does not call the quota service.
